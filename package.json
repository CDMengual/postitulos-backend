{
  "name": "postitulos-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npx nodemon --watch src --exec ts-node src/index.ts",
    "admin:create": "node scripts/createAdmin.cjs",
    "user:create": "node scripts/createAdmin.cjs",
    "seed:postitulos": "node -r ts-node/register prisma/postitulosSeed.ts",
    "seed:postitulos-detalles": "node scripts/updatePostitulosDetalles.cjs",
    "seed:postitulos-tipos": "node scripts/updatePostitulosTipos.cjs",
    "seed:formularios": "node -r dotenv/config -r ts-node/register prisma/seed.ts",
    "seed:cohortes": "node scripts/seedCohortesPostgres.cjs",
    "seed:referentes-prueba": "node scripts/seedReferentesPrueba.cjs",
    "seed:aulas-reducidas": "node scripts/reducirAulasPrueba.cjs",
    "seed:dashboard-prueba": "node scripts/seedDashboardPrueba.cjs",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@supabase/supabase-js": "^2.98.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "prisma": "^6.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.10.0",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
