# Supabase > Connect > Session pooler (IPv4), puerto 5432.
# Reemplazar host, project-ref y password; codificar caracteres especiales del password como URL.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
# Conexion para migraciones. Session pooler tambien funciona sin IPv6.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
JWT_SECRET="REEMPLAZAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO"
PORT=4000
CLIENT_URL="http://localhost:3000"
NODE_ENV="development"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="REEMPLAZAR_POR_SERVICE_ROLE_KEY"
SUPABASE_BUCKET="inscripciones-documentos"
PUBLIC_UPLOAD_MAX_BYTES=8388608
